{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SiteStudyo Sales OS",
  "version": "0.1.0",
  "identifier": "com.sitestudyo.salesos",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "SiteStudyo Sales OS",
        "width": 1440,
        "height": 900,
        "minWidth": 1040,
        "minHeight": 640,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data:",
        "font-src": "'self' data:",
        "connect-src": "'self' ipc: http://ipc.localhost https://* http://*"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "SiteStudyo",
    "copyright": "SiteStudyo",
    "category": "Business",
    "shortDescription": "Müşteri bulma ve satış takibi",
    "longDescription": "İşletme keşfi, web sitesi analizi, lead puanlama ve satış hunisi. Kendi sunucunuza bağlanır.",
    "windows": {
      "wix": {
        "language": [
          "tr-TR",
          "en-US"
        ]
      }
    }
  }
}