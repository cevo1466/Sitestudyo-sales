# docker-compose.yml'in okudugu degiskenler.
# Kurulum:  cp .env.example .env
# Bu dosya (.env) ASLA depoya girmez — .gitignore engelliyor.

# Redis konteyneri (host'ta 6379 ve 6380 dolu)
REDIS_PORT=6381

# API'nin localhost'ta yayinlandigi port.
# nginx vhost buraya degil, konteyner adina (salesos_backend:5080) proxy'ler.
API_PORT=5080

# NOT: veritabani ayarlari burada degil, backend/.env icinde (DATABASE_URL).
# Kendi Postgres/MySQL konteynerimiz yok; sunucudaki mevcut MariaDB'de
# ayri bir `salesos` veritabani kullaniliyor.
